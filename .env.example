# ==============================================================================
# Vehisoft Dealership Management System — Environment Variables
# ==============================================================================

# 1. Neon Serverless PostgreSQL
# Pooled connection string (used by Prisma Client at runtime on Vercel)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/vehisoft?sslmode=require&pgbouncer=true"

# Direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/vehisoft?sslmode=require"

# 2. Authentication (NextAuth / Auth.js)
# Generate via: npx auth secret
AUTH_SECRET="replace-with-a-secure-32-char-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# 3. Localization & Dealership Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY="KSh."
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE="KES"
NEXT_PUBLIC_DEALERSHIP_NAME="Vehisoft Motors"

# 4. Cron Job Security (Vercel Cron for auto-expiring vehicle reservations)
CRON_SECRET="replace-with-cron-verification-secret"
